{
  "name": "@myrishta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude dist/**",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "generate:openapi": "tsx src/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@myrishta/contracts": "workspace:*",
    "@myrishta/db": "workspace:*",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
