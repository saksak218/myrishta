{
  "name": "@myrishta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude dist/**",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "generate:openapi": "tsx src/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@hono/zod-openapi": "1.5.1",
    "@myrishta/contracts": "workspace:*",
    "@myrishta/db": "workspace:*",
    "hono": "4.12.32",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
